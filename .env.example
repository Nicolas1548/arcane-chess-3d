# Configuração Opcional do Firebase para Multiplayer Online em Nuvem
# Copie este arquivo para .env.local e preencha com as chaves do seu projeto Firebase.
# Caso não preenchido, o jogo utiliza automaticamente o motor de sincronização local (BroadcastChannel).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
